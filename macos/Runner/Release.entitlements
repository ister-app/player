<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Everything the app does is a network call: GraphQL, HLS segments, images,
	     epub resources and the OIDC discovery/token endpoints. Without this the
	     release build silently fails to reach any server while `flutter run`
	     (which uses DebugProfile.entitlements) works fine. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- flutter_secure_storage keeps the OIDC tokens in the Keychain; a sandboxed,
	     team-signed build (TestFlight / Mac App Store) gets no keychain access
	     without this group. Ad-hoc builds ignore it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.ister.player</string>
	</array>
</dict>
</plist>
